# ---------------------------------------------------------------------------
# NYX — plantilla de variables de entorno
#
# Copia este archivo a .env.local y rellena los valores reales:
#   cp .env.example .env.local
#
# .env.local esta en .gitignore: NUNCA subas claves reales al repositorio.
#
# En Vercel, estas mismas variables se cargan en
#   Project Settings -> Environment Variables (Production / Preview)
# y se descargan a local con:  npm run env:pull
#
# Sin estas variables el sitio publico sigue funcionando, pero sirviendo datos
# de demostracion. El panel de administracion si las necesita.
# ---------------------------------------------------------------------------

# --- Supabase: valores publicos (llegan al navegador) ----------------------
# Dashboard -> Project Settings -> Data API
#
# El prefijo NEXT_PUBLIC_ es obligatorio: sin el, el navegador no los ve y
# fallan la sesion del panel y la subida del logo del cliente.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: valor secreto (SOLO servidor) -------------------------------
# Se salta TODAS las politicas RLS. Nunca la expongas en el navegador ni le
# pongas el prefijo NEXT_PUBLIC_. Solo para funciones de servidor y webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ------------------------------------------------------------------
# Dominio publico, para resolver las imagenes de Open Graph. En Vercel se
# deduce solo; ponlo si usas un dominio propio.
# NEXT_PUBLIC_SITIO_URL=https://nyx.ec

# --- Supabase: solo para el CLI en local ----------------------------------
# Necesarios para `npm run db:link` y `npm run db:push`. Tambien se pueden
# introducir de forma interactiva.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
