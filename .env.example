# ---------------------------------------------------------------------------
# NYX — plantilla de variables de entorno
#
# Copia este archivo a .env.local y rellena los valores reales.
#   cp .env.example .env.local
#
# .env.local esta en .gitignore: NUNCA subas claves reales al repositorio.
# En Vercel, estas mismas variables se cargan en
#   Project Settings -> Environment Variables (Production / Preview / Development)
# y se descargan en local con:  npm run env:pull
# ---------------------------------------------------------------------------

# --- Supabase: valores publicos (se exponen en el navegador) ---------------
# Dashboard -> Project Settings -> Data API
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave anonima / publishable. Solo permite lo que autoricen las politicas RLS.
SUPABASE_ANON_KEY=

# Si en el futuro se migra a Next.js, duplica los dos de arriba con prefijo
# NEXT_PUBLIC_ para que lleguen al cliente:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: valor secreto (SOLO servidor) -------------------------------
# Salta todas las politicas RLS. Nunca la expongas en el navegador ni la
# marques como NEXT_PUBLIC_. Usala solo en funciones de servidor / webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: solo para el CLI en local ----------------------------------
# Contrasena de la base de datos del proyecto, necesaria para `supabase link`
# y `supabase db push`. Tambien puedes pasarla de forma interactiva.
SUPABASE_DB_PASSWORD=

# Referencia del proyecto (la parte TU-PROYECTO de la URL de arriba)
SUPABASE_PROJECT_REF=
