{
  "name": "nyx",
  "version": "0.1.0",
  "private": true,
  "description": "NYX — sitio de sublimacion y personalizacion + panel de administracion.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "env:pull": "vercel env pull .env.local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --linked > lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "supabase": "^2.0.0",
    "typescript": "^5.6.0",
    "vercel": "^48.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
